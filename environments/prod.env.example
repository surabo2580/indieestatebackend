# Copy to repo root:  cp environments/prod.env.example .env.prod
# Never commit .env.prod. Use Secrets Manager on ECS in production.

APP_ENV=prod
SPRING_PROFILES_ACTIVE=postgres,api,prod

API_BASE_URL=https://api.example.com

POSTGRES_DB=indieestate
POSTGRES_USER=indieestate_prod
POSTGRES_PASSWORD=from-secrets-manager
SPRING_DATASOURCE_URL=jdbc:postgresql://indieestate-prod.xxxxx.ap-south-1.rds.amazonaws.com:5432/indieestate

JWT_SECRET=from-secrets-manager
JWT_ISSUER=indieestate-backend
JWT_ACCESS_TOKEN_TTL_SECONDS=7200
PORT=8080

AUTH_OTP_DEV_MODE=false
AUTH_OTP_REDIS_ENABLED=true
AUTH_OTP_SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=from-secrets-manager

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REELS_S3_BUCKET=indiestate-reels-prod
REELS_CDN_BASE_URL=https://dxxxxx.cloudfront.net
REELS_FFMPEG_PATH=ffmpeg
REELS_ALLOW_DIRECT_UPLOAD=false
REELS_SKIP_S3=false

REELS_KAFKA_ENABLED=true
REELS_RUN_MEDIA_WORKER=false
REELS_REDIS_ENABLED=true
REELS_TRANSCODE_PROVIDER=ffmpeg
REELS_UPLOAD_STALE_HOURS=24
REELS_ADMIN_RECONCILE_TOKEN=from-secrets-manager
KAFKA_BOOTSTRAP_SERVERS=b-1.prod.xxxx.kafka.ap-south-1.amazonaws.com:9092
REDIS_HOST=indieestate-prod.xxxxx.cache.amazonaws.com
REDIS_PORT=6379

# CORS_ALLOWED_ORIGINS=https://app.example.com
