SPRING_PROFILES_ACTIVE=postgres
POSTGRES_DB=indieestate
POSTGRES_USER=surajdas
POSTGRES_PASSWORD=surajdas
JWT_SECRET=change-me-in-prod-at-least-32-chars
JWT_ISSUER=indieestate-backend
JWT_ACCESS_TOKEN_TTL_SECONDS=7200
PORT=8080

# OTP login — dev (default): logs OTP + debugOtp in API response
AUTH_OTP_DEV_MODE=true
# AUTH_OTP_DEV_OTP=123456

# Production OTP (when AUTH_OTP_DEV_MODE=false):
# AUTH_OTP_REDIS_ENABLED=true
# AUTH_OTP_SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Reels: S3 + CloudFront (leave bucket empty to use in-memory fake storage)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REELS_S3_BUCKET=indieestate-reels-uat
REELS_CDN_BASE_URL=https://dibq9bniduqup.cloudfront.net
REELS_FFMPEG_PATH=ffmpeg
# Production: keep false. Dev-only bypass of S3 (not scalable):
REELS_ALLOW_DIRECT_UPLOAD=false
REELS_SKIP_S3=false

# V2 media pipeline. Leave false unless docker-compose Kafka/Redis are running.
REELS_KAFKA_ENABLED=false
REELS_REDIS_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379
