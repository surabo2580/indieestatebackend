# Optional laptop dev only. Copy: cp environments/local.env.example .env.local
# Prefer UAT on AWS: use .env.uat instead (see docs/UAT_REELS_SETUP.md).

APP_ENV=local
SPRING_PROFILES_ACTIVE=postgres,api
API_BASE_URL=http://localhost:8080

POSTGRES_DB=indieestate
POSTGRES_USER=surajdas
POSTGRES_PASSWORD=surajdas

JWT_SECRET=change-me-in-prod-at-least-32-chars
JWT_ISSUER=indieestate-backend
JWT_ACCESS_TOKEN_TTL_SECONDS=7200
PORT=8080

AUTH_OTP_DEV_MODE=true
AUTH_OTP_REDIS_ENABLED=false

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REELS_S3_BUCKET=indiestate-reels-uat
REELS_CDN_BASE_URL=https://dibq9bniduqup.cloudfront.net
REELS_FFMPEG_PATH=ffmpeg
REELS_ALLOW_DIRECT_UPLOAD=false
REELS_SKIP_S3=false

REELS_KAFKA_ENABLED=true
REELS_RUN_MEDIA_WORKER=false
REELS_REDIS_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379
