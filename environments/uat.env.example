# Copy to repo root:  cp environments/uat.env.example .env.uat
# Load before run/deploy:  source scripts/load-env.sh uat
#
# UAT uses the same shape as prod — only values (URLs, bucket, secrets) differ.

APP_ENV=uat
SPRING_PROFILES_ACTIVE=postgres,api,uat

# --- API public URL (Android base URL, verify-reels-flow.sh) ---
API_BASE_URL=https://uat-api.example.com

# --- RDS PostgreSQL ---
POSTGRES_DB=indieestate
POSTGRES_USER=indieestate_uat
POSTGRES_PASSWORD=change-me-uat-db
SPRING_DATASOURCE_URL=jdbc:postgresql://indieestate-uat.xxxxx.ap-south-1.rds.amazonaws.com:5432/indieestate

# --- Auth ---
JWT_SECRET=change-me-uat-min-32-chars-random
JWT_ISSUER=indieestate-backend-uat
JWT_ACCESS_TOKEN_TTL_SECONDS=7200
PORT=8080

# UAT: real OTP optional; can use dev OTP until SMS is wired
AUTH_OTP_DEV_MODE=false
AUTH_OTP_REDIS_ENABLED=true
AUTH_OTP_SMS_PROVIDER=logging
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# --- AWS reels (UAT bucket + distribution) ---
AWS_REGION=ap-south-1
# ECS UAT: prefer task role — leave keys empty on tasks; set keys for deploy scripts / verify only
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REELS_S3_BUCKET=indiestate-reels-uat
REELS_CDN_BASE_URL=https://dxxxxx.cloudfront.net
REELS_FFMPEG_PATH=ffmpeg
REELS_ALLOW_DIRECT_UPLOAD=false
REELS_SKIP_S3=false

# --- Kafka / Redis (UAT MSK + ElastiCache endpoints) ---
REELS_KAFKA_ENABLED=true
REELS_RUN_MEDIA_WORKER=false
REELS_REDIS_ENABLED=true
REELS_TRANSCODE_PROVIDER=ffmpeg
REELS_UPLOAD_STALE_HOURS=24
REELS_ADMIN_RECONCILE_TOKEN=change-me-uat-reconcile
KAFKA_BOOTSTRAP_SERVERS=b-1.uat.xxxx.kafka.ap-south-1.amazonaws.com:9092,b-2.uat.xxxx.kafka.ap-south-1.amazonaws.com:9092
REDIS_HOST=indieestate-uat.xxxxx.cache.amazonaws.com
REDIS_PORT=6379

# Optional CORS (comma-separated origins)
# CORS_ALLOWED_ORIGINS=https://uat.example.com
